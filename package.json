{
  "name": "scribbies-adventure",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-art.mjs && node scripts/prepare-art-study.mjs && vite build && node scripts/service-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js && node --check src/game.js && node --check src/storage.js && npm test",
    "preview": "vite preview --host 127.0.0.1",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "release:stage": "node scripts/stage-eas.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource/nunito": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "sharp": "^0.35.4",
    "vite": "8.2.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
